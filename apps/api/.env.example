# ==============================================================================
# AlterTrack API (NestJS) - Variables d'environnement (Exemple)
# ==============================================================================

PORT=3000
NODE_ENV=production

# Clé API statique (min 32 caractères)
API_KEY=change_this_secret_api_key_min_32_chars_for_production

# Secret JWT pour l'authentification des utilisateurs (min 32 caractères)
JWT_SECRET=change_this_jwt_secret_key_min_32_chars_for_production
JWT_EXPIRES_IN=30d

# Origines autorisées CORS (séparées par une virgule, ou * pour tout autoriser)
CORS_ORIGINS=*

# Répertoire de stockage des fichiers uploadés (CV)
UPLOAD_DIR=/app/uploads

# Chaîne de connexion PostgreSQL Prisma
DATABASE_URL=postgresql://altertrack:altertrack_secret_dev@localhost:5432/altertrack_db?schema=public

# IA Google Gemini
GEMINI_API_KEY=AIzaSyFakeKeyForDemonstrationOnly

# Envoi Gmail par défaut
GMAIL_USER=mon.adresse@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
