{
  "expo": {
    "name": "AlterTrack",
    "slug": "altertrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "altertrack",
    "userInterfaceStyle": "dark",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AlterTrack utilise votre position pour calculer la distance des entreprises autour de vous."
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.altertrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altertrack.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AlterTrack utilise votre position pour calculer la distance des entreprises autour de vous et afficher vos trajets pertinents."
      }
    },
    "owner": "marfael",
    "extra": {
      "eas": {
        "projectId": "c6851702-e698-44f5-ab78-341994cd0ac4"
      }
    }
  }
}