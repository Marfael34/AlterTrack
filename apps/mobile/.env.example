# ==============================================================================
# AlterTrack Mobile - Variables d'environnement (Exemple)
# ==============================================================================

# URL racine de l'API AlterTrack en production (ex: https://api.altertrack.fr)
# Si non renseignée, l'application bascule automatiquement sur les réglages ou le tunnel distant.
EXPO_PUBLIC_API_URL=https://api.altertrack.fr

# Clé API pour la sécurité de base de l'API (doit correspondre à API_KEY du serveur)
EXPO_PUBLIC_API_KEY=votre_cle_api_securisee_min_32_chars

# Assure que le moteur réseau de React Native gère correctement FormData (uploads de fichiers)
EXPO_PUBLIC_USE_RN_FETCH=1
