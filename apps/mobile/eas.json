{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1",
        "EXPO_PUBLIC_API_URL": "https://altertrack.duckdns.org"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1",
        "EXPO_PUBLIC_API_URL": "https://altertrack.duckdns.org"
      }
    }
  },
  "submit": {
    "production": {}
  }
}