{
  "name": "altertrack",
  "version": "1.0.0",
  "description": "Application Mobile & Serveur d'Automatisation de Candidatures d'Alternance",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:start": "npm --prefix apps/api run start",
    "api:dev": "npm --prefix apps/api run start:dev",
    "api:build": "npm --prefix apps/api run build",
    "api:test": "npm --prefix apps/api run test",
    "api:lint": "npm --prefix apps/api run lint",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:tunnel": "npm --prefix apps/mobile run start -- --tunnel",
    "mobile:web": "npm --prefix apps/mobile run web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "tunnel": "node scripts/tunnel.js",
    "tunnel:watch": "node scripts/tunnel-watchdog.js"
  },
  "keywords": [
    "nest",
    "react-native",
    "expo",
    "prisma",
    "postgresql",
    "automation"
  ],
  "author": "Rafael Martinez",
  "license": "UNLICENSED"
}
