# ==============================================================================
# AlterTrack - Variables d'environnement (Exemple)
# Copier ce fichier vers .env et renseigner les vraies valeurs.
# NE JAMAIS COMMETTRE LE FICHIER .env !
# ==============================================================================

# ------------------------------------------------------------------------------
# Serveur Backend (NestJS)
# ------------------------------------------------------------------------------
# Port d'écoute de l'API NestJS (Obligatoire, défaut: 3000)
PORT=3000

# Environnement d'exécution : development | production | test (Obligatoire)
NODE_ENV=production

# Clé d'API statique pour sécuriser la communication Mobile <-> Backend (Obligatoire)
# Doit être une chaîne aléatoire d'au moins 32 caractères (générer via: openssl rand -hex 32)
API_KEY=change_this_secret_api_key_min_32_chars_for_production

# Secret JWT pour la signature des sessions utilisateurs (Obligatoire en production)
# Générer une chaîne aléatoire robuste (ex: openssl rand -hex 32)
JWT_SECRET=change_this_jwt_secret_key_min_32_chars_for_production

# Durée de validité des jetons JWT (défaut: 30d)
JWT_EXPIRES_IN=30d

# Origines autorisées CORS pour le serveur en production (séparées par une virgule)
# Ex: https://altertrack.fr,https://app.altertrack.fr (ou * si accès ouvert/mobile natif)
CORS_ORIGINS=*

# Répertoire de stockage des fichiers uploadés (ex: CV) (Optionnel, défaut: /app/uploads en Docker)
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# Base de données PostgreSQL & Prisma
# ------------------------------------------------------------------------------
# Utilisateur PostgreSQL pour Docker Compose (Obligatoire)
POSTGRES_USER=altertrack

# Mot de passe PostgreSQL (Obligatoire - définir une valeur robuste pour la prod)
POSTGRES_PASSWORD=definir_un_mot_de_passe_robuste_ici

# Nom de la base de données (Obligatoire)
POSTGRES_DB=altertrack_db

# Port externe exposé pour PostgreSQL (Obligatoire, défaut: 5432)
# En production, il est recommandé de ne pas exposer ce port publiquement ou de le lier à 127.0.0.1
POSTGRES_PORT=5432

# Chaîne de connexion complète utilisée par Prisma
# Pour Docker Compose interne (service NestJS) :
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# Service IA - Google Gemini (Étape 2)
# ------------------------------------------------------------------------------
# Clé d'API Google Gemini AI Studio (Obligatoire pour la génération d'e-mails)
# Obtenable sur : https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyFakeKeyForDemonstrationOnly

# ------------------------------------------------------------------------------
# Messagerie Gmail - SMTP (Envoi) & IMAP (Détection réponses) (Étape 2)
# ------------------------------------------------------------------------------
# Adresse Gmail par défaut (Peut aussi être configurée individuellement par chaque utilisateur)
GMAIL_USER=mon.adresse@gmail.com

# Mot de passe d'application Google (16 caractères)
# Généré dans le compte Google -> Sécurité -> Mots de passe des applications
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ------------------------------------------------------------------------------
# Application Mobile Expo (Variables publiques embarquées lors du build)
# ------------------------------------------------------------------------------
# URL racine publique de l'API de production accessible par les téléphones
EXPO_PUBLIC_API_URL=https://api.altertrack.fr
