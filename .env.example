# ==============================================================================
# AlterTrack - Variables d'environnement (Exemple)
# Copier ce fichier vers .env et renseigner les vraies valeurs.
# NE JAMAIS COMMETTRE LE FICHIER .env !
# ==============================================================================

# ------------------------------------------------------------------------------
# Serveur Backend (NestJS)
# ------------------------------------------------------------------------------
# Port d'écoute de l'API NestJS (Obligatoire)
PORT=3000

# Environnement d'exécution : development | production | test (Obligatoire)
NODE_ENV=development

# Clé d'API statique pour sécuriser la communication Mobile <-> Backend (Obligatoire)
# Doit correspondre à l'en-tête 'x-api-key' envoyé par l'application React Native
API_KEY=change_this_secret_api_key_min_32_chars

# Répertoire de stockage des fichiers uploadés (ex: CV) (Optionnel, défaut: ./uploads)
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Base de données PostgreSQL & Prisma
# ------------------------------------------------------------------------------
# Utilisateur PostgreSQL pour Docker Compose (Obligatoire)
POSTGRES_USER=altertrack

# Mot de passe PostgreSQL (Obligatoire - définir une valeur robuste)
POSTGRES_PASSWORD=altertrack_secret_dev

# Nom de la base de données (Obligatoire)
POSTGRES_DB=altertrack_db

# Port externe exposé pour PostgreSQL (Obligatoire, défaut: 5432)
POSTGRES_PORT=5432

# Chaîne de connexion complète utilisée par Prisma (Obligatoire)
DATABASE_URL=postgresql://altertrack:altertrack_secret_dev@localhost:5432/altertrack_db?schema=public

# ------------------------------------------------------------------------------
# Service IA - Google Gemini (Étape 2)
# ------------------------------------------------------------------------------
# Clé d'API Google Gemini AI Studio (Obligatoire pour la génération d'e-mails)
# Obtenable gratuitement sur : https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyFakeKeyForDemonstrationOnly

# ------------------------------------------------------------------------------
# Messagerie Gmail - SMTP (Envoi) & IMAP (Détection réponses) (Étape 2)
# ------------------------------------------------------------------------------
# Adresse Gmail de l'utilisateur (expéditeur) (Obligatoire)
GMAIL_USER=mon.adresse@gmail.com

# Mot de passe d'application Google (16 caractères) (Obligatoire)
# Généré dans le compte Google -> Sécurité -> Mots de passe des applications
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ------------------------------------------------------------------------------
# Notifications Push Mobile (Expo) (Étape 5)
# ------------------------------------------------------------------------------
# Jeton Push Expo généré par l'application mobile (Peut être configuré dynamiquement)
# EXPO_PUSH_TOKEN=ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]
